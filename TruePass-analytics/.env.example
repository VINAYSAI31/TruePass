# ---------------------------------------------------------------------------
# TruePass analytics ETL - configuration template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL
# Local development: localhost
# EC2 / Docker Compose: postgres  (the Compose service hostname)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=truepass
DB_USERNAME=your_username
DB_PASSWORD=your_password

# AWS
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-bucket-name

# ---------------------------------------------------------------------------
# Optional - sensible defaults apply if these are omitted
# ---------------------------------------------------------------------------
# Set to false to run the ETL without touching S3 (useful for local validation)
UPLOAD_TO_S3=true
# Base S3 prefix for all uploaded objects
S3_BASE_PREFIX=truepass-analytics
# Local directories
OUTPUT_DIR=output
LOG_DIR=logs
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
